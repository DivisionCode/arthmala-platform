# Arthmala API environment. Copy to server/.env for local development.
# Placeholder values only. Never commit a real .env file.

# Port for local development (server.js). Not used on Vercel.
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Secret used to sign and verify login JWTs. Set a long random string in every
# deployed environment; the code falls back to a built-in development value if unset.
JWT_SECRET=

# Who receives inquiry emails
DESIGNER_EMAIL=designer@example.com

# Where the frontend is served (used for CORS). Comma-separated list allowed.
CLIENT_ORIGIN=http://localhost:5173

# SMTP: optional; if unset, inquiries are still saved to DB but no email is sent,
# and login codes are printed to the server console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin dashboard shared-secret (any long random string)
ADMIN_TOKEN=

# Public site URL (used by /sitemap.xml and /robots.txt)
PUBLIC_SITE_URL=http://localhost:5173

# Optional base URL for links returned by the image upload endpoint.
# Defaults to the protocol and host of the upload request.
UPLOAD_BASE_URL=

# When true, Express trusts X-Forwarded-For (set to true on Render/Heroku/behind a proxy).
# NODE_ENV=production has the same effect and also switches request logging to "combined".
TRUST_PROXY=false
