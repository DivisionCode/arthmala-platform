# Arthmala client environment. Copy to client/.env.local for local development.
# Placeholder values only. Never commit a real .env file.

# Base URL of the API. Leave empty to call the same origin (/api/*), as on Vercel.
VITE_API_URL=http://localhost:5000

# +country+number, no spaces or + sign (e.g. 919812345678 for India)
VITE_WHATSAPP_NUMBER=919999999999

# Analytics (optional: set ONE when ready; Plausible preferred)
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=
VITE_GA_ID=
